{
    "name": "pythonteacher",
    "publisher": "PythonTeacher",
    "displayName": "Python Teacher",
    "description": "The Python Teacher extension is your personal guide to mastering Python within Visual Studio Code. Perfect for beginners and intermediate learners alike, this extension brings interactive lessons, code challenges, and real-time feedback right to your editor.",
    "version": "2.0.0",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.94.0"
    },
    "categories": [
        "Education",
        "Other"
    ],
    "activationEvents": [
        "onLanguage:python",
        "onView:pythonTeacherSidebar"
    ],
    "main": "./extension.js",
    "contributes": {
        "configuration": {
            "title": "Python Teacher",
            "properties": {
                "pythonteacher.language": {
                    "type": "string",
                    "enum": [
                        "en",
                        "fa"
                    ],
                    "default": "en",
                    "description": "Interface language for Python Teacher"
                },
                "pythonteacher.timeoutMs": {
                    "type": "number",
                    "default": 10000,
                    "description": "Timeout in milliseconds for code execution"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "pythonTeacherSidebar",
                    "title": "Python Teacher",
                    "icon": "./assets/t.svg"
                }
            ]
        },
        "views": {
            "pythonTeacherSidebar": [
                {
                    "id": "pythonTeacherView",
                    "name": "Python Teacher",
                    "type": "webview",
                    "icon": "./assets/t.svg",
                    "contextualTitle": "Python Teacher"
                }
            ]
        },
        "commands": [
            {
                "command": "pythonteacher.openSidebar",
                "title": "Open Python Teacher Sidebar",
                "icon": "$(book)"
            },
            {
                "command": "pythonteacher.openLesson",
                "title": "Open Lesson"
            },
            {
                "command": "pythonteacher.openPractice",
                "title": "Open Practice Exercise"
            },
            {
                "command": "pythonteacher.setLanguage",
                "title": "Set Language"
            },
            {
                "command": "pythonteacher.resetProgress",
                "title": "Reset Progress"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "pythonteacher.openSidebar",
                    "when": "view == pythonTeacherSidebar",
                    "group": "navigation"
                },
                {
                    "command": "pythonteacher.resetProgress",
                    "when": "view == pythonTeacherSidebar",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "pythonteacher.openSidebar",
                    "when": "editorLangId == python",
                    "group": "1_modification"
                }
            ]
        },
        "keybindings": [
            {
                "command": "pythonteacher.openSidebar",
                "key": "ctrl+alt+l",
                "mac": "cmd+alt+l",
                "when": "editorTextFocus"
            }
        ]
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "26.x",
        "@types/vscode": "^1.140.0",
        "eslint": "^10.12.0"
    }
}
